{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/project.schema.json",
  "title": "AI YouTube Project",
  "description": "Canonical metadata for one video production project.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "language",
    "target_audience",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "topic": {
      "type": "string",
      "maxLength": 1000
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "default": "en"
    },
    "target_audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "format": {
      "type": "string",
      "enum": [
        "cinematic_documentary",
        "explainer",
        "short"
      ]
    },
    "target_duration_seconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 7200
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "completed",
        "archived"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_notes": {
      "type": "string",
      "maxLength": 10000
    },
    "approval_required": {
      "type": "boolean",
      "default": true
    }
  }
}
